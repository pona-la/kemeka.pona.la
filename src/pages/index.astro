---
import "selo-components/common.css"; // has to be above site-specific css

import DictSearch from "@/components/DictSearch.svelte";
import "@/global.css";
import { getCollection } from "astro:content";
import { Layout } from "selo-components";
import { config } from "selo-components/config";
---

<Layout title={config.title} description={config.description}>
  <main>
    <p>
      Welcome to <a href="/about">lipu Kemeka</a>, a free English to Toki Pona
      dictionary made by the Toki Pona community. See how translating to Toki
      Pona depends on what English words mean in context.
    </p>
    <DictSearch posts={await getCollection("dictionary")} client:load />
  </main>
</Layout>
