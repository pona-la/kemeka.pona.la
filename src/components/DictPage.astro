---
import type { CollectionEntry } from "astro:content";
import { marked } from "marked";

interface Props {
  post: CollectionEntry<"content">;
}

const { post } = Astro.props;
async function md(text: string) {
  const link_replacer = (_: any, text: string) =>
    `[${text}](?q=${text.replaceAll(" ", "_")})`;
  const linked_text = text.replaceAll(/\[(.+?)\](?!\()/g, link_replacer);
  const html_string = await marked.parse(linked_text);
  return html_string.replaceAll(/\<\/?p\>/g, "");
}
---

{
  post.data.definitions && (
    <ol>
      {post.data.definitions.map((definition) => (
        <li>
          <span set:html={md(definition.eng)} />
          <span> — </span>
          <b set:html={md(definition.tok)} />
          {definition.examples && (
            <ul>
              {definition.examples.map((example) => (
                <li>
                  <i set:html={md(example.tok)} />
                  <br />
                  <span set:html={md(example.eng)} />
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ol>
  )
}

